# Crear localmente un archivo application.properties con los siguientes datos:

spring.application.name=vaotrip-demo

# Configuración de seguridad de la sesión HTTP

# Utiliza únicamente cookies para gestionar el seguimiento de sesiones.
# Evita incluir el identificador de sesión en las URL.
server.servlet.session.tracking-modes=cookie

# Impide que JavaScript acceda a la cookie de sesión.
# Ayuda a mitigar el robo de cookies mediante ataques XSS.
server.servlet.session.cookie.http-only=true

# Restringe el envío de la cookie en solicitudes entre sitios,
# permitiendo normalmente la navegación desde enlaces externos.
# Ofrece protección parcial frente a ataques CSRF.
server.servlet.session.cookie.same-site=lax

# Desactiva la caché de plantillas Thymeleaf durante el desarrollo.
# Permite visualizar cambios en las plantillas sin reiniciar la aplicación.
spring.thymeleaf.cache=false

spring.main.banner-mode=off

# Habilitar para conectarse a la bd, se debe colocar el nombre de la base de datos al final de la ruta:
#spring.datasource.url=jdbc:postgresql://localhost:5432/
# Habilitar para conectarse a la bd, se debe colocar el nombre del usuario que accede a la base de datos:
#spring.datasource.username=
# Habilitar para conectarse a la bd, se debe colocar la contraseña del usuario que accede a la base de datos:
#spring.datasource.password=

spring.datasource.driver-class-name=org.postgresql.Driver

#spring.jpa.hibernate.ddl-auto=validate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Para produccion:
# Hace que la cookie solamente se envíe mediante HTTPS.
#server.servlet.session.cookie.secure=true
